<configs>
	<!-- Unser Menü -->
	<append xpath="/windows">
		<!-- HÖHE GEÄNDERT: Von 677 auf 597 -->
		<window name="windowEinmaligerSpawnAdmin" width="354" height="597" panel="Right" controller="GrafischeModEinstellungen, EinmaligerSpawn" cursor_area="true">
			<rect name="header" pos="3,0" height="43" depth="1">
				<headerbg />
				<sprite depth="1" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_computer"/>
				<label style="header.name" text="Einmaliger Spawn" />
			</rect>

			<!-- HÖHE GEÄNDERT: Von 634 auf 554 -->
			<rect name="content" depth="0" pos="0,-43" height="554">
				<!-- HÖHE GEÄNDERT: Von 628 auf 548 -->
				<sprite depth="0" name="backgroundMain" sprite="menu_empty3px" pos="3,-3" width="348" height="548" color="[black]" type="sliced" fillcenter="true" />

				<!-- ==================== CLIENT BEFEHLE ==================== -->
				<!-- Map Overlay -->
				<label depth="2" pos="10,-20" width="120" height="30" text="MAP OVERLAY" font_size="20" />
				<simplebutton name="btnToggleMap" pos="130,-18" width="100" height="30" caption="ACTIVE" />
				<simplebutton name="btnReloadMap" pos="240,-18" width="100" height="30" caption="RELOAD" />

				<!-- Notifications -->
				<label depth="2" pos="10,-60" width="120" height="30" text="NOTIFICATIONS" font_size="20" />
				<simplebutton name="btnToggleMsg" pos="130,-58" width="100" height="30" caption="ACTIVE" />

				<!-- Clearing Status (HUD Tracker) -->
				<label depth="2" pos="10,-100" width="120" height="30" text="HUD CLEARING STATUS" font_size="16" />
				<simplebutton name="btnToggleClearing" pos="130,-98" width="85" height="30" caption="ACTIVE" />
				<combobox name="cbxClearingRadius" type="ComboBoxInt" pos="220,-98" width="80" height="30" value_min="15" value_max="500" value_increment="5" format_string="0" />
				<simplebutton name="btnApplyClearing" pos="305,-98" width="40" height="30" caption="SET" />

				<!-- Universal Radar -->
				<label depth="2" pos="10,-140" width="120" height="30" text="RADAR" font_size="20" />
				<simplebutton name="btnMarkEnemy" pos="130,-138" width="180" height="30" caption="MARK NEAREST ENEMY" />


				<!-- ==================== ADMIN BEFEHLE ===================== -->
				<!-- Optische Trennlinie & Admin Header -->
				<sprite depth="1" pos="10,-185" width="328" height="2" color="255,255,255,128" type="sliced" />
				<label depth="2" pos="10,-190" width="328" height="30" text="ES ADMIN MENU" font_size="22" justify="center" color="192,192,192,255" />
				<sprite depth="1" pos="10,-220" width="328" height="2" color="255,255,255,128" type="sliced" />

				<!-- 1. ES Zombie Limit -->
				<label depth="2" pos="10,-235" width="120" height="30" text="ZOMBIE LIMIT" font_size="20" />
				<combobox name="cbxLimit" type="ComboBoxInt" pos="130,-233" width="130" height="30" value_min="0" value_max="150" value_increment="1" format_string="0" />
				<simplebutton name="btnApplyLimit" pos="270,-233" width="70" height="30" caption="APPLY" />

				<!-- 2. ES Spawn Timer -->
				<label depth="2" pos="10,-275" width="120" height="30" text="SPAWN TIMER" font_size="20" />
				<combobox name="cbxTimer" type="ComboBoxInt" pos="130,-273" width="130" height="30" value_min="1" value_max="60" value_increment="1" format_string="0" />
				<simplebutton name="btnApplyTimer" pos="270,-273" width="70" height="30" caption="APPLY" />

				<!-- 3. Target Player -->
				<label depth="2" pos="10,-315" width="120" height="30" text="TARGET PLAYER" font_size="20" />
				<simplebutton name="btnPlayerPrev" pos="130,-313" width="25" height="30" caption="&lt;" />
				<sprite depth="1" pos="157,-313" width="103" height="30" color="60,60,60,255" type="sliced" />
				<label name="lblPlayerName" depth="2" pos="157,-318" width="103" height="30" text="---" justify="center" font_size="18" />
				<simplebutton name="btnPlayerNext" pos="262,-313" width="25" height="30" caption="&gt;" />

				<!-- 4. Local Clear -->
				<label depth="2" pos="10,-355" width="120" height="30" text="LOCAL CLEAR" font_size="20" />
				<simplebutton name="btnToggleLocalClear" pos="130,-353" width="100" height="30" caption="DISABLED" />
				<simplebutton name="btnLocalClearDiagnose" pos="240,-353" width="100" height="30" caption="DIAGNOSE" />

				<!-- 5. Tactical Kill -->
				<label depth="2" pos="10,-395" width="120" height="30" text="TACTICAL KILL" font_size="20" />
				<simplebutton name="btnToggleTactical" pos="130,-393" width="130" height="30" caption="DISABLED" />

				<!-- 6. Cheat Loud -->
				<label depth="2" pos="10,-435" width="120" height="30" text="CHEAT LOUD" font_size="20" />
				<combobox name="cbxCheatLoudRooms" type="ComboBoxInt" pos="130,-433" width="130" height="30" value_min="1" value_max="20" value_increment="1" format_string="0" />
				<simplebutton name="btnCheatLoud" pos="270,-433" width="70" height="30" caption="APPLY" />

				<!-- 7. Cheat Clear -->
				<label depth="2" pos="10,-475" width="120" height="30" text="CHEAT CLEAR" font_size="20" />
				<combobox name="cbxClearRadius" type="ComboBoxInt" pos="130,-473" width="130" height="30" value_min="10" value_max="250" value_increment="10" format_string="0" />
				<simplebutton name="btnCheatClear" pos="270,-473" width="70" height="30" caption="CLEAR" />

			</rect>
		</window>
	</append>

	<!-- Der funktionierende Text-Button -->
	<append xpath="/windows/window[@name='mapArea']/rect[@name='header']">
		<simplebutton depth="2" name="btnESAdminToggleText" pos="450,-6" width="140" height="32" caption="Hide ES Menu" font_size="18" tooltip="ES Admin Menu" sound="[paging_click]" />
	</append>
</configs>