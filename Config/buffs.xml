<configs>
	<append xpath="/buffs">
		<!-- name_key, description_key und tooltip_key wurden hinzugefügt -->
		<buff name="buffEinmaligerSpawnProgress" name_key="buffEinmaligerSpawnProgressName" description_key="buffEinmaligerSpawnProgressDesc" tooltip_key="buffEinmaligerSpawnProgressTooltip" icon="ui_game_symbol_map" icon_color="0,255,0" hidden="false">
			<stack_type value="replace"/>
			<duration value="0"/>
			<display_value value="esLocalClearPercent"/>
			<!-- Hier ist der Vanilla-Trick: Direktes String-Format statt Localization-Key -->
			<display_value_key value="{0}%"/>
		</buff>
	</append>
</configs>